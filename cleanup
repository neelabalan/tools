#!/usr/bin/env python3

import abc
import argparse
import dataclasses
import datetime
import fnmatch
import logging
import os
import pathlib
import shutil
import subprocess
import sys
import typing
from collections.abc import Callable
from collections.abc import Iterator

logger = logging.getLogger('cleanup')

SKIP_DIRS = frozenset({'node_modules', '.git', 'vendor', 'site-packages'})


@dataclasses.dataclass(frozen=True)
class Options:
    base_path: pathlib.Path
    dry_run: bool = False
    auto_confirm: bool = False
    types: tuple[str, ...] = ()


class CleanupItem(abc.ABC):
    name: str
    description: str

    @property
    def size(self) -> int | None:
        return None

    @abc.abstractmethod
    def clean(self) -> bool:
        pass


class PathCleanupItem(CleanupItem):
    def __init__(self, path: pathlib.Path, description: str):
        self.path = path
        self.name = str(path)
        self.description = description
        self._cached_size: int | None = None

    @property
    def size(self) -> int | None:
        if self._cached_size is None:
            self._cached_size = get_folder_size(self.path) if self.path.exists() else 0
        return self._cached_size

    def clean(self) -> bool:
        try:
            shutil.rmtree(self.path)
            return True
        except FileNotFoundError:
            return True


class CommandCleanupItem(CleanupItem):
    def __init__(self, name: str, description: str, command: list[str]):
        self.name = name
        self.description = description
        self.command = command

    def clean(self) -> bool:
        result = subprocess.run(self.command, capture_output=True, text=True)
        if result.returncode == 0:
            if result.stdout.strip():
                logger.info(f'  {result.stdout.strip()}')
            return True
        logger.error(f'  {result.stderr.strip()}')
        return False


@dataclasses.dataclass
class CleanupResult:
    success_count: int = 0
    failure_count: int = 0
    size_freed: int = 0
    errors: list[str] = dataclasses.field(default_factory=list)


class Cleaner(abc.ABC):
    registry: dict[str, type['Cleaner']] = {}
    name: str = ''
    project_scoped: bool = False

    def __init_subclass__(cls, name: str | None = None, **kwargs: typing.Any) -> None:
        super().__init_subclass__(**kwargs)
        if name:
            cls.name = name
            cls.registry[name] = cls

    def __init__(self, options: Options):
        self.options = options

    @abc.abstractmethod
    def scan(self) -> list[CleanupItem]:
        pass

    def can_handle(self) -> bool:
        return True

    def execute(self) -> CleanupResult:
        if not self.can_handle():
            return CleanupResult()

        items = self.scan()
        if not items:
            logger.info(f'{self.name}: nothing to clean')
            return CleanupResult()

        path_items = [i for i in items if isinstance(i, PathCleanupItem)]
        command_items = [i for i in items if isinstance(i, CommandCleanupItem)]
        total_size = sum(i.size or 0 for i in path_items)

        size_summary = format_size(total_size) if path_items else ''
        if command_items:
            size_summary += f'{" + " if size_summary else ""}{len(command_items)} command(s)'
        logger.info(f'{self.name}: found {len(items)} items ({size_summary})')

        for item in items:
            size_str = f' ({format_size(item.size)})' if item.size is not None else ''
            logger.info(f'  {item.name}{size_str} - {item.description}')

        if self.options.dry_run:
            logger.info(f'DRY RUN: would clean {len(items)} items')
            return CleanupResult()

        if not self.options.auto_confirm and not confirm_action(f'Clean {len(items)} items?'):
            return CleanupResult()

        result = CleanupResult()
        for item in items:
            try:
                if item.clean():
                    result.success_count += 1
                    if item.size is not None:
                        result.size_freed += item.size
                else:
                    result.failure_count += 1
            except Exception as e:
                logger.error(f'  Failed to clean {item.name}: {e}')
                result.errors.append(f'{item.name}: {e}')
                result.failure_count += 1

        return result


class CommandCleaner(Cleaner):
    command: list[str] = []
    description: str = ''

    def can_handle(self) -> bool:
        return shutil.which(self.command[0]) is not None

    def scan(self) -> list[CleanupItem]:
        return [CommandCleanupItem(self.name, self.description, self.command)]


class ContainerCleaner(Cleaner):
    engine: str = ''
    prune_commands: dict[str, tuple[list[str], str]] = {}

    def can_handle(self) -> bool:
        return shutil.which(self.engine) is not None

    def scan(self) -> list[CleanupItem]:
        types = self.options.types or tuple(self.prune_commands)
        return [
            CommandCleanupItem(name=t, description=desc, command=[self.engine, *args])
            for t, (args, desc) in self.prune_commands.items()
            if t in types
        ]


def find_dirs(base: pathlib.Path, match: Callable[[str, pathlib.Path], str | None]) -> Iterator[PathCleanupItem]:
    """Yield a PathCleanupItem for each directory where match(name, parent) returns a description.

    Matched and skipped directories are pruned, so their contents are never walked.
    """
    for dirpath, dirnames, _ in os.walk(base):
        parent = pathlib.Path(dirpath)
        kept = []
        for name in dirnames:
            description = match(name, parent)
            if description is not None:
                yield PathCleanupItem(parent / name, description)
            elif name not in SKIP_DIRS:
                kept.append(name)
        dirnames[:] = kept


def has_file(base: pathlib.Path, pattern: str) -> bool:
    for _, dirnames, filenames in os.walk(base):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        if any(fnmatch.fnmatch(f, pattern) for f in filenames):
            return True
    return False


PYTHON_CACHE_DIRS = {
    '__pycache__': 'bytecode cache',
    '.pytest_cache': 'pytest cache',
    '.mypy_cache': 'mypy cache',
    '.ruff_cache': 'ruff cache',
}
VENV_NAMES = {'.venv', 'venv', '.virtualenv', 'env'}


class PythonCleaner(Cleaner, name='python'):
    project_scoped = True

    def can_handle(self) -> bool:
        base = self.options.base_path
        indicators = ['requirements.txt', 'setup.py', 'pyproject.toml', 'Pipfile']
        return any((base / f).exists() for f in indicators) or has_file(base, '*.py')

    def scan(self) -> list[CleanupItem]:
        def match(name: str, parent: pathlib.Path) -> str | None:
            if name in PYTHON_CACHE_DIRS:
                return PYTHON_CACHE_DIRS[name]
            if name in VENV_NAMES and (parent / name / 'pyvenv.cfg').exists():
                return 'virtual environment'
            if fnmatch.fnmatch(name, '*.egg-info'):
                return 'egg metadata'
            return None

        return list(find_dirs(self.options.base_path, match))


NODE_BUILD_DIRS = ('dist', 'build', '.next', '.nuxt')


class NodeCleaner(Cleaner, name='node'):
    project_scoped = True

    def can_handle(self) -> bool:
        return (self.options.base_path / 'package.json').exists()

    def scan(self) -> list[CleanupItem]:
        def match(name: str, parent: pathlib.Path) -> str | None:
            if name not in ('node_modules', *NODE_BUILD_DIRS) or not (parent / 'package.json').exists():
                return None
            return 'dependencies' if name == 'node_modules' else 'build output'

        return list(find_dirs(self.options.base_path, match))


class RustCleaner(Cleaner, name='rust'):
    project_scoped = True

    def can_handle(self) -> bool:
        return (self.options.base_path / 'Cargo.toml').exists()

    def scan(self) -> list[CleanupItem]:
        def match(name: str, parent: pathlib.Path) -> str | None:
            if name == 'target' and (parent / 'Cargo.toml').exists():
                return 'build artifacts'
            return None

        return list(find_dirs(self.options.base_path, match))


class DockerCleaner(ContainerCleaner, name='docker'):
    engine = 'docker'
    prune_commands = {
        'containers': (['container', 'prune', '-f'], 'stopped containers'),
        'images': (['image', 'prune', '-a', '-f'], 'unused images'),
        'volumes': (['volume', 'prune', '-f'], 'unused volumes'),
        'networks': (['network', 'prune', '-f'], 'unused networks'),
        'cache': (['buildx', 'prune', '-f'], 'build cache'),
    }


class PodmanCleaner(ContainerCleaner, name='podman'):
    engine = 'podman'
    prune_commands = {
        'containers': (['container', 'prune', '-f'], 'stopped containers'),
        'images': (['image', 'prune', '-a', '-f'], 'unused images'),
        'volumes': (['volume', 'prune', '-f'], 'unused volumes'),
    }


class BrewCleaner(CommandCleaner, name='brew'):
    command = ['brew', 'cleanup', '--prune=all']
    description = 'cache and old versions'


class PipCleaner(CommandCleaner, name='pip'):
    command = ['pip', 'cache', 'purge']
    description = 'package cache'


class UvCleaner(CommandCleaner, name='uv'):
    command = ['uv', 'cache', 'clean']
    description = 'package cache'


class NpmCleaner(CommandCleaner, name='npm'):
    command = ['npm', 'cache', 'clean', '--force']
    description = 'package cache'


def setup_logging() -> None:
    debug_enabled = os.environ.get('DEBUG', '').lower() in ('1', 'true')
    level = logging.DEBUG if debug_enabled else logging.INFO
    fmt = logging.Formatter('%(asctime)s | %(levelname)s | %(message)s')

    logger.setLevel(level)
    logger.propagate = False

    console_handler = logging.StreamHandler()
    console_handler.setFormatter(fmt)
    console_handler.setLevel(level)
    logger.addHandler(console_handler)

    if debug_enabled:
        log_dir = pathlib.Path.home() / '.dotfiles' / '.logs' / 'cleanup'
        log_dir.mkdir(parents=True, exist_ok=True)
        log_file = log_dir / f'cleanup_{datetime.datetime.now().strftime("%Y%m%d_%H%M%S")}.log'
        file_handler = logging.FileHandler(log_file, encoding='utf-8')
        file_handler.setFormatter(fmt)
        file_handler.setLevel(level)
        logger.addHandler(file_handler)
        logger.debug('logger initialized (level=%s) file=%s', logging.getLevelName(level), log_file)


def get_folder_size(folder_path: pathlib.Path) -> int:
    total_size = 0
    try:
        for dirpath, _, filenames in os.walk(folder_path, followlinks=False):
            for filename in filenames:
                file_path = pathlib.Path(dirpath) / filename
                try:
                    total_size += file_path.lstat().st_size
                except (OSError, FileNotFoundError):
                    pass
    except (OSError, PermissionError):
        pass
    return total_size


def format_size(size_bytes: int) -> str:
    size = float(size_bytes)
    for unit in ['B', 'KB', 'MB', 'GB']:
        if size < 1024.0:
            return f'{size:.1f} {unit}'
        size /= 1024.0
    return f'{size:.1f} TB'


def confirm_action(prompt: str) -> bool:
    response = input(f'{prompt} [y/N]: ').strip().lower()
    return response in ['y', 'yes']


def split_values(values: list[str] | None) -> list[str]:
    return list(dict.fromkeys(v.strip() for value in values or [] for v in value.split(',') if v.strip()))


def main() -> None:
    parser = argparse.ArgumentParser(
        description='Development environment cleanup tool for reclaiming disk space',
        epilog="""
Project cleaners (run on PATH by default when their project files are present):
  python    Clean __pycache__, .venv, .pytest_cache, .mypy_cache, .ruff_cache,
            and *.egg-info directories
  node      Clean node_modules, dist, build, .next, .nuxt directories
  rust      Clean target directories (Cargo build artifacts)

System cleaners (run only when named with --cleaners):
  docker    Clean stopped containers, unused images, volumes, networks, build cache
  podman    Clean stopped containers, unused images, volumes
  brew      Clean Homebrew cache and old package versions
  pip       Purge pip package cache
  uv        Clean uv package cache
  npm       Clean npm package cache

Types (for docker/podman, see --types):
  containers, images, volumes, networks, cache

Examples:
  %(prog)s ~/projects/myapp                        Clean project artifacts in a directory
  %(prog)s --dry-run .                             Preview what would be cleaned
  %(prog)s -c python,node .                        Run only the Python and Node cleaners
  %(prog)s -c python --yes .                       Clean Python artifacts without confirmation
  %(prog)s -c docker                               Clean all unused Docker artifacts
  %(prog)s -c docker -t images                     Clean only unused Docker images
  %(prog)s -c docker -t containers -t volumes      Clean containers and volumes only
  %(prog)s -c brew,npm                             Clean Homebrew and npm caches

Environment:
  DEBUG=1    Enable debug logging with file output to ~/.dotfiles/.logs/cleanup/
        """,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        'path', nargs='?', default='.', help='Directory to scan for cleanable items (default: current directory)'
    )
    parser.add_argument(
        '--dry-run', '-n', action='store_true', help='Show what would be cleaned without actually deleting anything'
    )
    parser.add_argument('--yes', '-y', action='store_true', help='Skip confirmation prompts and clean immediately')
    parser.add_argument(
        '--cleaners',
        '-c',
        action='append',
        metavar='CLEANER',
        help=f'Cleaners to run, comma-separated or repeated: {", ".join(Cleaner.registry.keys())} '
        '(default: project cleaners whose files are present)',
    )
    parser.add_argument(
        '--types',
        '-t',
        action='append',
        metavar='TYPE',
        help='For docker/podman: artifact types to clean, comma-separated or repeated (requires -c docker or -c podman)',
    )

    if len(sys.argv) == 1:
        parser.print_help()
        return

    args = parser.parse_args()
    setup_logging()

    cleaner_names = split_values(args.cleaners)
    types = split_values(args.types)

    unknown_cleaners = [n for n in cleaner_names if n not in Cleaner.registry]
    if unknown_cleaners:
        parser.error(f'unknown cleaner(s): {", ".join(unknown_cleaners)}')

    target_path = pathlib.Path(args.path).resolve()

    if not target_path.exists():
        logger.error(f'path does not exist: {target_path}')
        sys.exit(1)

    if not target_path.is_dir():
        logger.error(f'path is not a directory: {target_path}')
        sys.exit(1)

    options = Options(
        base_path=target_path,
        dry_run=args.dry_run,
        auto_confirm=args.yes,
        types=tuple(types),
    )
    all_cleaners = {name: cls(options) for name, cls in Cleaner.registry.items()}

    if cleaner_names:
        cleaners = [all_cleaners[name] for name in cleaner_names]
    else:
        cleaners = [c for c in all_cleaners.values() if c.project_scoped and c.can_handle()]

    if types:
        typed = [c for c in cleaners if isinstance(c, ContainerCleaner)]
        if not typed:
            parser.error('--types only applies to docker and podman; add -c docker or -c podman')
        supported = {t for c in typed for t in c.prune_commands}
        unknown_types = [t for t in types if t not in supported]
        if unknown_types:
            parser.error(f'unknown type(s): {", ".join(unknown_types)}; choose from {", ".join(sorted(supported))}')

    if not cleaners:
        logger.info('no applicable cleaners found; use -c to run system cleaners')
        sys.exit(1)

    logger.info(f'target: {target_path}')

    total_freed = 0
    total_success = 0
    total_failures = 0

    for cleaner in cleaners:
        result = cleaner.execute()
        total_freed += result.size_freed
        total_success += result.success_count
        total_failures += result.failure_count

    if total_success > 0:
        summary = f'total: {total_success} items'
        if total_freed > 0:
            summary += f', {format_size(total_freed)} freed'
        logger.info(summary)
    if total_failures > 0:
        logger.warning(f'failures: {total_failures}')


if __name__ == '__main__':
    main()
