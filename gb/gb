GIT_ENV = dict(os.environ, GIT_TERMINAL_PROMPT='0')
GITHUB_HOST = 'github.com'
CREDENTIALS_PATH = pathlib.Path.home() / '.config' / 'gb' / 'credentials.json'


@dataclasses.dataclass(frozen=True)
class RepoStatus:
    path: pathlib.Path
    branch: str
    has_upstream: bool
    ahead: int
    behind: int
    staged: int
    unstaged: int
    untracked: int
    conflicts: int
    stashes: int
    error: str


def run_git(repo: pathlib.Path, args: list[str], timeout: int = 15) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ['git', *args],
            cwd=repo,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=GIT_ENV,
        )
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 1, '', 'timed out')
    except OSError as err:
        return subprocess.CompletedProcess(args, 1, '', str(err))


def find_git_repos(root: pathlib.Path, max_depth: int) -> list[pathlib.Path]:
    if (root / '.git').exists():
        return [root]
    return walk_for_repos(root, max_depth)


def walk_for_repos(directory: pathlib.Path, depth_remaining: int) -> list[pathlib.Path]:
    if depth_remaining < 0:
        return []
    try:
        entries = sorted(directory.iterdir())
    except PermissionError:
        return []

    repos = []
    for entry in entries:
        if not entry.is_dir():
            continue
        if (entry / '.git').exists():
            repos.append(entry)
            continue
        repos.extend(walk_for_repos(entry, depth_remaining - 1))
    return repos


def parse_status_lines(lines: list[str]) -> dict[str, str | int | bool]:
    branch = 'HEAD'
    has_upstream = False
    ahead = 0
    behind = 0
    staged = 0
    unstaged = 0
    untracked = 0
    conflicts = 0

    for line in lines:
        if line.startswith('# branch.head '):
            branch = line.split(' ', 2)[2]
        elif line.startswith('# branch.upstream '):
            has_upstream = True
        elif line.startswith('# branch.ab '):
            _, _, ahead_part, behind_part = line.split()
            ahead = int(ahead_part.lstrip('+'))
            behind = int(behind_part.lstrip('-'))
        elif line.startswith('1 ') or line.startswith('2 '):
            xy = line.split(' ', 2)[1]
            staged += xy[0] != '.'
            unstaged += xy[1] != '.'
        elif line.startswith('u '):
            conflicts += 1
        elif line.startswith('? '):
            untracked += 1

    return {
        'branch': branch,
        'has_upstream': has_upstream,
        'ahead': ahead,
        'behind': behind,
        'staged': staged,
        'unstaged': unstaged,
        'untracked': untracked,
        'conflicts': conflicts,
    }


def count_stashes(repo: pathlib.Path) -> int:
    result = run_git(repo, ['stash', 'list'])
    if result.returncode != 0:
        return 0
    return len([line for line in result.stdout.splitlines() if line.strip()])


def collect_status(repo: pathlib.Path) -> RepoStatus:
    result = run_git(repo, ['status', '--porcelain=2', '--branch'])
    if result.returncode != 0:
        return RepoStatus(repo, '', False, 0, 0, 0, 0, 0, 0, 0, result.stderr.strip())

    fields = parse_status_lines(result.stdout.splitlines())
    stashes = count_stashes(repo)
    return RepoStatus(path=repo, stashes=stashes, error='', **fields)


def fetch_repo(repo: pathlib.Path) -> None:
    run_git(repo, ['fetch', '--quiet', '--all'], timeout=30)


def collect_all(repos: list[pathlib.Path], fetch: bool, workers: int) -> list[RepoStatus]:
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        if fetch:
            list(executor.map(fetch_repo, repos))
        return list(executor.map(collect_status, repos))


def is_dirty(status: RepoStatus) -> bool:
    return status.staged > 0 or status.unstaged > 0 or status.untracked > 0 or status.conflicts > 0


def is_out_of_sync(status: RepoStatus) -> bool:
    return status.ahead > 0 or status.behind > 0


def status_label(status: RepoStatus) -> str:
    if status.error:
        return 'error'

    labels = []
    if is_dirty(status):
        labels.append('dirty')
    if status.ahead > 0 and status.behind > 0:
        labels.append('diverged')
    elif status.ahead > 0:
        labels.append('ahead')
    elif status.behind > 0:
        labels.append('behind')
    if not status.has_upstream:
        labels.append('no-upstream')

    return ','.join(labels) if labels else 'clean'


def changes_summary(status: RepoStatus) -> str:
    parts = []
    if status.staged:
        parts.append(f'{status.staged}staged')
    if status.unstaged:
        parts.append(f'{status.unstaged}modified')
    if status.untracked:
        parts.append(f'{status.untracked}untracked')
    if status.conflicts:
        parts.append(f'{status.conflicts}conflict')
    if status.stashes:
        parts.append(f'{status.stashes}stash')
    return ' '.join(parts) if parts else '-'


def first_error_line(message: str) -> str:
    stripped = message.strip()
    if not stripped:
        return 'unknown error'
    return stripped.splitlines()[0]


def ahead_behind(status: RepoStatus) -> str:
    if status.ahead == 0 and status.behind == 0:
        return '-'
    return f'+{status.ahead}/-{status.behind}'


def matches_filter(status: RepoStatus, dirty_only: bool, out_of_sync_only: bool) -> bool:
    if dirty_only and not is_dirty(status):
        return False
    if out_of_sync_only and not is_out_of_sync(status):
        return False
    return True


def print_report(statuses: list[RepoStatus], dirty_only: bool, out_of_sync_only: bool) -> None:
    visible = [s for s in statuses if matches_filter(s, dirty_only, out_of_sync_only)]
    if not visible:
        print('no repositories matched')
        return

    name_width = max(len(s.path.name) for s in visible)
    label_width = max(len(status_label(s)) for s in visible)
    branch_width = max(len(s.branch) for s in visible)
    for status in visible:
        if status.error:
            print(
                f'{status.path.name:<{name_width}}  '
                f'{"error":<{label_width}}  '
                f'{"-":<{branch_width}}  '
                f'{"-":<8}  '
                f'{first_error_line(status.error):<28}  '
                f'{status.path}'
            )
            continue
        print(
            f'{status.path.name:<{name_width}}  '
            f'{status_label(status):<{label_width}}  '
            f'{status.branch:<{branch_width}}  '
            f'{ahead_behind(status):<8}  '
            f'{changes_summary(status):<28}  '
            f'{status.path}'
        )


def print_summary(statuses: list[RepoStatus]) -> None:
    total = len(statuses)
    dirty = sum(is_dirty(s) for s in statuses)
    out_of_sync = sum(is_out_of_sync(s) for s in statuses)
    no_upstream = sum(not s.has_upstream and not s.error for s in statuses)
    errors = sum(bool(s.error) for s in statuses)
    clean = sum(status_label(s) == 'clean' for s in statuses)

    print()
    print(f'total repos: {total}')
    print(f'clean: {clean}')
    print(f'with uncommitted changes: {dirty}')
    print(f'out of sync with upstream: {out_of_sync}')
    print(f'without an upstream branch: {no_upstream}')
    print(f'errors: {errors}')


def print_json(statuses: list[RepoStatus]) -> None:
    rows = [
        dataclasses.asdict(s) | {'name': s.path.name, 'path': str(s.path), 'label': status_label(s)} for s in statuses
    ]
    print(json.dumps(rows, indent=2))


def resolve_repos(paths: list[pathlib.Path], depth: int) -> list[pathlib.Path]:
    repos = []
    for path in paths:
        if not path.exists():
            print(f'path does not exist: {path}', file=sys.stderr)
            continue
        repos.extend(find_git_repos(path.resolve(), depth))
    return repos


def run_status(args: argparse.Namespace) -> None:
    repos = resolve_repos(args.paths, args.depth)
    if not repos:
        sys.exit('no git repositories found')

    statuses = collect_all(repos, args.fetch, args.workers)
    statuses.sort(key=lambda s: s.path.name.lower())

    if args.json:
        print_json(statuses)
        return

    print_report(statuses, args.dirty, args.out_of_sync)
    if not args.quiet:
        print_summary(statuses)


@dataclasses.dataclass(frozen=True)
class RemoteRepo:
    name: str
    clone_url: str
    ssh_url: str
    fork: bool
    archived: bool


@dataclasses.dataclass(frozen=True)
class Entry:
    name: str
    path: str
    is_dir: bool
    download_url: str = ''


def http_json(url: str, headers: dict[str, str], exit_on_error: bool = True) -> dict | list | None:
    request = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.loads(response.read().decode('utf-8'))
    except urllib.error.HTTPError as err:
        if exit_on_error:
            sys.exit(f'api error for {url}: {err.code} {err.reason}')
        return None
    except urllib.error.URLError as err:
        if exit_on_error:
            sys.exit(f'failed to reach {url}: {err.reason}')
        return None


def download_file(url: str, destination: pathlib.Path, headers: dict[str, str]) -> bool:
    request = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(response.read())
        return True
    except (urllib.error.HTTPError, urllib.error.URLError, OSError) as err:
        print(f'failed to download {destination}: {err}', file=sys.stderr)
        return False


def encode(value: str) -> str:
    return urllib.parse.quote(value, safe='')


class Forge(abc.ABC):
    """A git hosting service. Each subclass speaks one service's api, the rest of gb only uses this interface."""

    name: str
    git_username: str

    def __init__(self, host: str, token: str = ''):
        self.host = canonical_host(host)
        self.token = token

    @property
    @abc.abstractmethod
    def api(self) -> str: ...

    @abc.abstractmethod
    def api_headers(self) -> dict[str, str]: ...

    @abc.abstractmethod
    def whoami(self) -> str: ...

    @abc.abstractmethod
    def token_url(self) -> str: ...

    @abc.abstractmethod
    def token_hint(self) -> str: ...

    @abc.abstractmethod
    def list_repos(self, account: str) -> list[RemoteRepo]: ...

    @abc.abstractmethod
    def parse_url(self, parts: list[str]) -> tuple[str, str, str]:
        """returns (project, ref, path), ref is empty when the url does not name one"""

    @abc.abstractmethod
    def default_branch(self, project: str) -> str: ...

    @abc.abstractmethod
    def describe(self, project: str, path: str, ref: str) -> Entry | None: ...

    @abc.abstractmethod
    def list_dir(self, project: str, path: str, ref: str) -> list[Entry] | None: ...

    def account_from_path(self, parts: list[str]) -> str:
        return parts[0]

    def api_get(self, path: str, exit_on_error: bool = True) -> dict | list | None:
        return http_json(f'{self.api}{path}', self.api_headers(), exit_on_error)

    def git_auth_header(self) -> str:
        credentials = base64.b64encode(f'{self.git_username}:{self.token}'.encode()).decode()
        return f'Authorization: basic {credentials}'


class GitHubForge(Forge):
    name = 'github'
    git_username = 'x-access-token'

    @property
    def api(self) -> str:
        if self.host == GITHUB_HOST:
            return f'https://api.{GITHUB_HOST}'
        return f'https://{self.host}/api/v3'

    def api_headers(self) -> dict[str, str]:
        headers = {'Accept': 'application/vnd.github+json'}
        if self.token:
            headers['Authorization'] = f'Bearer {self.token}'
        return headers

    def whoami(self) -> str:
        return self.api_get('/user')['login']

    def token_url(self) -> str:
        return f'https://{self.host}/settings/tokens'

    def token_hint(self) -> str:
        return 'a classic token with repo and read:org scopes, or a fine-grained token with read access to contents'

    def list_repos(self, account: str) -> list[RemoteRepo]:
        owner = self.api_get(f'/users/{account}')
        endpoint = 'orgs' if owner.get('type') == 'Organization' else 'users'

        repos = []
        page = 1
        while True:
            batch = self.api_get(f'/{endpoint}/{account}/repos?per_page=100&page={page}')
            if not batch:
                break
            repos.extend(RemoteRepo(r['name'], r['clone_url'], r['ssh_url'], r['fork'], r['archived']) for r in batch)
            if len(batch) < 100:
                break
            page += 1
        return repos

    def parse_url(self, parts: list[str]) -> tuple[str, str, str]:
        if len(parts) < 3:
            sys.exit('expected format: https://<host>/owner/repo/tree/branch/path/to/folder or .../blob/branch/path/to/file')
        project = '/'.join(parts[:2])
        if parts[2] in ('tree', 'blob') and len(parts) > 3:
            ref, path = parts[3], '/'.join(parts[4:])
        else:
            ref, path = '', '/'.join(parts[2:])
        if not path:
            sys.exit('no folder or file path found in url')
        return project, ref, path

    def default_branch(self, project: str) -> str:
        return self.api_get(f'/repos/{project}').get('default_branch', 'main')

    def describe(self, project: str, path: str, ref: str) -> Entry | None:
        data = self.api_get(f'/repos/{project}/contents/{path}?ref={ref}', exit_on_error=False)
        if isinstance(data, dict) and data.get('type') == 'file':
            return Entry(data['name'], data['path'], False, data['download_url'])
        if isinstance(data, list):
            return Entry(path.split('/')[-1], path, True)
        return None

    def list_dir(self, project: str, path: str, ref: str) -> list[Entry] | None:
        data = self.api_get(f'/repos/{project}/contents/{path}?ref={ref}', exit_on_error=False)
        if not isinstance(data, list):
            return None
        return [
            Entry(item['name'], item['path'], item['type'] == 'dir', item.get('download_url') or '')
            for item in data
            if item['type'] in ('dir', 'file')
        ]


class GitLabForge(Forge):
    name = 'gitlab'
    git_username = 'oauth2'

    @property
    def api(self) -> str:
        return f'https://{self.host}/api/v4'

    def api_headers(self) -> dict[str, str]:
        return {'PRIVATE-TOKEN': self.token} if self.token else {}

    def whoami(self) -> str:
        return self.api_get('/user')['username']

    def token_url(self) -> str:
        return f'https://{self.host}/-/user_settings/personal_access_tokens'

    def token_hint(self) -> str:
        return 'a personal access token with read_api and read_repository scopes'

    def account_from_path(self, parts: list[str]) -> str:
        return '/'.join(parts)

    def list_repos(self, account: str) -> list[RemoteRepo]:
        if self.api_get(f'/groups/{encode(account)}', exit_on_error=False) is not None:
            endpoint, params = f'/groups/{encode(account)}/projects', {'include_subgroups': 'true'}
        else:
            endpoint, params = f'/users/{encode(account)}/projects', {}

        repos = []
        page = 1
        while True:
            query = urllib.parse.urlencode(params | {'per_page': 100, 'page': page})
            batch = self.api_get(f'{endpoint}?{query}')
            if not batch:
                break
            for project in batch:
                name = project['path_with_namespace'].removeprefix(f'{account}/')
                repos.append(
                    RemoteRepo(
                        name,
                        project['http_url_to_repo'],
                        project['ssh_url_to_repo'],
                        'forked_from_project' in project,
                        project.get('archived', False),
                    )
                )
            if len(batch) < 100:
                break
            page += 1
        return repos

    def parse_url(self, parts: list[str]) -> tuple[str, str, str]:
        hint = 'expected format: https://<host>/group/project/-/tree/branch/path/to/folder or .../-/blob/branch/path/to/file'
        if '-' not in parts:
            sys.exit(hint)
        separator = parts.index('-')
        rest = parts[separator + 1 :]
        if len(rest) < 3 or rest[0] not in ('tree', 'blob'):
            sys.exit(hint)
        project = '/'.join(parts[:separator])
        return project, rest[1], '/'.join(rest[2:])

    def default_branch(self, project: str) -> str:
        return self.api_get(f'/projects/{encode(project)}').get('default_branch', 'main')

    def describe(self, project: str, path: str, ref: str) -> Entry | None:
        files_url = f'/projects/{encode(project)}/repository/files/{encode(path)}?ref={encode(ref)}'
        name = path.split('/')[-1]
        if self.api_get(files_url, exit_on_error=False) is not None:
            return Entry(name, path, False, self._raw_url(project, path, ref))
        if self._tree_page(project, path, ref, 1):
            return Entry(name, path, True)
        return None

    def list_dir(self, project: str, path: str, ref: str) -> list[Entry] | None:
        entries = []
        page = 1
        while True:
            batch = self._tree_page(project, path, ref, page)
            if batch is None:
                return None
            for item in batch:
                if item['type'] not in ('tree', 'blob'):
                    continue
                is_dir = item['type'] == 'tree'
                download_url = '' if is_dir else self._raw_url(project, item['path'], ref)
                entries.append(Entry(item['name'], item['path'], is_dir, download_url))
            if len(batch) < 100:
                break
            page += 1
        return entries

    def _tree_page(self, project: str, path: str, ref: str, page: int) -> list | None:
        query = urllib.parse.urlencode({'path': path, 'ref': ref, 'per_page': 100, 'page': page})
        data = self.api_get(f'/projects/{encode(project)}/repository/tree?{query}', exit_on_error=False)
        return data if isinstance(data, list) else None

    def _raw_url(self, project: str, path: str, ref: str) -> str:
        return f'{self.api}/projects/{encode(project)}/repository/files/{encode(path)}/raw?ref={encode(ref)}'


FORGE_TYPES: dict[str, type[Forge]] = {'github': GitHubForge, 'gitlab': GitLabForge}
KNOWN_HOSTS = {'github.com': 'github', 'gitlab.com': 'gitlab'}


def canonical_host(host: str) -> str:
    host = host.lower()
    return GITHUB_HOST if host == f'www.{GITHUB_HOST}' else host


def split_target(target: str) -> tuple[str, list[str]]:
    if '://' not in target:
        if '.' not in target.partition('/')[0]:
            return GITHUB_HOST, [part for part in target.split('/') if part]
        target = f'https://{target}'
    parsed = urllib.parse.urlparse(target)
    return canonical_host(parsed.netloc), [part for part in parsed.path.split('/') if part]


def load_credentials() -> dict[str, dict[str, str]]:
    if not CREDENTIALS_PATH.exists():
        return {}
    raw = json.loads(CREDENTIALS_PATH.read_text())
    # older files stored a bare github token per host
    return {
        host: {'forge': 'github', 'token': value} if isinstance(value, str) else value for host, value in raw.items()
    }


def save_credentials(credentials: dict[str, dict[str, str]]) -> None:
    CREDENTIALS_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(CREDENTIALS_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as file:
        json.dump(credentials, file, indent=2)


def open_forge(host: str, explicit_token: str = '') -> Forge:
    host = canonical_host(host)
    stored = load_credentials().get(host, {})
    forge_name = stored.get('forge') or KNOWN_HOSTS.get(host)
    if not forge_name:
        sys.exit(f'unknown host: {host}, log in first with: gb login {host} --forge github|gitlab')
    return FORGE_TYPES[forge_name](host, explicit_token or stored.get('token', ''))


def run_login(args: argparse.Namespace) -> None:
    host = canonical_host(args.host)
    forge_name = args.forge or KNOWN_HOSTS.get(host)
    if not forge_name:
        sys.exit(f'unknown host: {host}, pass --forge github or --forge gitlab')

    if args.with_token:
        token = sys.stdin.read().strip()
    else:
        forge = FORGE_TYPES[forge_name](host)
        print(f'create {forge.token_hint()} at {forge.token_url()}')
        token = getpass.getpass(f'token for {host}: ').strip()
    if not token:
        sys.exit('no token provided')

    username = FORGE_TYPES[forge_name](host, token).whoami()
    credentials = load_credentials()
    credentials[host] = {'forge': forge_name, 'token': token}
    save_credentials(credentials)
    print(f'logged in to {host} ({forge_name}) as {username}, token saved to {CREDENTIALS_PATH}')


def run_logout(args: argparse.Namespace) -> None:
    host = canonical_host(args.host)
    credentials = load_credentials()
    if host not in credentials:
        print(f'no saved login for {host}')
        return
    del credentials[host]
    save_credentials(credentials)
    print(f'removed saved login for {host}')


def filter_repos(repos: list[RemoteRepo], include_forks: bool, include_archived: bool) -> list[RemoteRepo]:
    result = []
    for repo in repos:
        if repo.fork and not include_forks:
            continue
        if repo.archived and not include_archived:
            continue
        result.append(repo)
    return result


def clone_env(forge: Forge, use_ssh: bool) -> dict[str, str]:
    if not forge.token or use_ssh:
        return GIT_ENV
    return GIT_ENV | {
        'GIT_CONFIG_COUNT': '1',
        'GIT_CONFIG_KEY_0': 'http.extraheader',
        'GIT_CONFIG_VALUE_0': forge.git_auth_header(),
    }


def clone_repo(repo: RemoteRepo, dest_dir: pathlib.Path, forge: Forge, use_ssh: bool) -> str:
    dest_path = dest_dir / repo.name
    if dest_path.exists():
        return f'skipped (already exists): {repo.name}'

    dest_path.parent.mkdir(parents=True, exist_ok=True)
    url = repo.ssh_url if use_ssh else repo.clone_url
    result = subprocess.run(
        ['git', 'clone', '--quiet', url, str(dest_path)],
        capture_output=True,
        text=True,
        env=clone_env(forge, use_ssh),
    )
    if result.returncode != 0:
        return f'failed: {repo.name}: {first_error_line(result.stderr)}'
    return f'cloned: {repo.name}'


def clone_all(repos: list[RemoteRepo], dest_dir: pathlib.Path, forge: Forge, use_ssh: bool, workers: int) -> list[str]:
    dest_dir.mkdir(parents=True, exist_ok=True)
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        futures = [executor.submit(clone_repo, repo, dest_dir, forge, use_ssh) for repo in repos]
        return [future.result() for future in futures]


def print_clone_results(results: list[str]) -> None:
    for line in results:
        print(line)

    cloned = sum(line.startswith('cloned') for line in results)
    skipped = sum(line.startswith('skipped') for line in results)
    failed = sum(line.startswith('failed') for line in results)
    print()
    print(f'cloned: {cloned}, skipped: {skipped}, failed: {failed}')


def run_clone(args: argparse.Namespace) -> None:
    host, parts = split_target(args.target)
    if not parts:
        sys.exit(f'no account found in: {args.target}, expected format: https://<host>/<account>')
    forge = open_forge(host, args.token)
    account = forge.account_from_path(parts)

    print(f'looking up repositories for {account} on {host}')
    repos = filter_repos(forge.list_repos(account), args.include_forks, args.include_archived)
    if not repos:
        sys.exit('no repositories found')

    dest_dir = args.dest or pathlib.Path(account)
    print(f'cloning {len(repos)} repositories into {dest_dir}')
    results = clone_all(repos, dest_dir, forge, args.ssh, args.workers)
    print_clone_results(results)


def download_folder(
    forge: Forge,
    project: str,
    ref: str,
    folder: str,
    destination: pathlib.Path,
    executor: concurrent.futures.ThreadPoolExecutor,
) -> bool:
    entries = forge.list_dir(project, folder, ref)
    if entries is None:
        print(f'could not fetch folder contents: {folder}', file=sys.stderr)
        return False

    destination.mkdir(parents=True, exist_ok=True)
    success = True
    futures = []
    for entry in entries:
        if entry.is_dir:
            if not download_folder(forge, project, ref, entry.path, destination / entry.name, executor):
                success = False
        else:
            print(f'downloading {entry.path}')
            futures.append(executor.submit(download_file, entry.download_url, destination / entry.name, forge.api_headers()))

    for future in concurrent.futures.as_completed(futures):
        if not future.result():
            success = False
    return success


def run_fetch(args: argparse.Namespace) -> None:
    host, parts = split_target(args.url)
    forge = open_forge(host, args.token)
    project, ref, path = forge.parse_url(parts)
    ref = ref or forge.default_branch(project)

    dest_path = args.dest or pathlib.Path(path.split('/')[-1])
    if dest_path.exists():
        sys.exit(f'destination already exists: {dest_path}')

    entry = forge.describe(project, path, ref)
    if entry is None:
        sys.exit(f'not found: {path} on {ref} in {project}')

    print(f'fetching {project}/{path} from {ref}')
    if not entry.is_dir:
        if not download_file(entry.download_url, dest_path, forge.api_headers()):
            sys.exit(f'failed to download file: {path}')
        print(f'fetched to: {dest_path}')
        return

    with concurrent.futures.ThreadPoolExecutor(max_workers=args.workers) as executor:
        success = download_folder(forge, project, ref, path, dest_path, executor)

    if not success:
        sys.exit(f'some files failed to download, see {dest_path}')
    print(f'fetched to: {dest_path}')


def pull_repo(status: RepoStatus) -> str:
    if status.error:
        return f'skipped (status error): {status.path.name}'
    if is_dirty(status):
        return f'skipped (dirty): {status.path.name}'
    if not status.has_upstream:
        return f'skipped (no upstream): {status.path.name}'

    result = run_git(status.path, ['pull', '--ff-only', '--quiet'], timeout=60)
    if result.returncode != 0:
        return f'failed: {status.path.name}: {first_error_line(result.stderr or result.stdout)}'
    return f'pulled: {status.path.name}'


def pull_all(statuses: list[RepoStatus], workers: int) -> list[str]:
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        return list(executor.map(pull_repo, statuses))


def print_pull_results(results: list[str]) -> None:
    for line in results:
        print(line)

    pulled = sum(line.startswith('pulled') for line in results)
    skipped = sum(line.startswith('skipped') for line in results)
    failed = sum(line.startswith('failed') for line in results)
    print()
    print(f'pulled: {pulled}, skipped: {skipped}, failed: {failed}')


def run_pull(args: argparse.Namespace) -> None:
    repos = resolve_repos(args.paths, args.depth)
    if not repos:
        sys.exit('no git repositories found')

    statuses = collect_all(repos, False, args.workers)
    results = pull_all(statuses, args.workers)
    print_pull_results(results)


def merged_branches(repo: pathlib.Path, protected: set[str]) -> list[str]:
    result = run_git(repo, ['branch', '--merged'])
    if result.returncode != 0:
        return []

    branches = []
    for line in result.stdout.splitlines():
        name = line.strip().lstrip('*').strip()
        if name and name not in protected:
            branches.append(name)
    return branches


def prune_repo(repo: pathlib.Path, protected: set[str], apply: bool) -> list[str]:
    branches = merged_branches(repo, protected)
    lines = []
    for branch in branches:
        if not apply:
            lines.append(f'would delete: {repo.name}/{branch}')
            continue
        result = run_git(repo, ['branch', '-d', branch])
        if result.returncode == 0:
            lines.append(f'deleted: {repo.name}/{branch}')
        else:
            lines.append(f'failed to delete: {repo.name}/{branch}: {first_error_line(result.stderr)}')
    return lines


def prune_all(repos: list[pathlib.Path], protected: set[str], apply: bool, workers: int) -> list[str]:
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        results = executor.map(lambda repo: prune_repo(repo, protected, apply), repos)
        return [line for lines in results for line in lines]


def run_prune(args: argparse.Namespace) -> None:
    repos = resolve_repos(args.paths, args.depth)
    if not repos:
        sys.exit('no git repositories found')

    protected = {name.strip() for name in args.protect.split(',') if name.strip()}
    lines = prune_all(repos, protected, args.apply, args.workers)
    if not lines:
        print('no merged branches found')
        return

    for line in lines:
        print(line)
    if not args.apply:
        print()
        print('dry run, nothing deleted, pass --apply to actually delete these branches')


@dataclasses.dataclass(frozen=True)
class StaleInfo:
    path: pathlib.Path
    last_commit_epoch: int | None
    days_idle: float


def last_commit_epoch(repo: pathlib.Path) -> int | None:
    result = run_git(repo, ['log', '-1', '--format=%ct'])
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return int(result.stdout.strip())


def collect_stale(repo: pathlib.Path) -> StaleInfo:
    epoch = last_commit_epoch(repo)
    if epoch is None:
        return StaleInfo(repo, None, -1.0)
    return StaleInfo(repo, epoch, (time.time() - epoch) / 86400)


def collect_all_stale(repos: list[pathlib.Path], workers: int) -> list[StaleInfo]:
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
        return list(executor.map(collect_stale, repos))


def print_stale_report(infos: list[StaleInfo], threshold_days: int) -> None:
    stale = [info for info in infos if info.last_commit_epoch is not None and info.days_idle >= threshold_days]
    stale.sort(key=lambda info: info.days_idle, reverse=True)
    if not stale:
        print(f'no repos idle for {threshold_days}+ days')
        return

    name_width = max(len(info.path.name) for info in stale)
    for info in stale:
        last_date = datetime.datetime.fromtimestamp(info.last_commit_epoch).date()
        print(f'{info.path.name:<{name_width}}  {info.days_idle:>6.0f}d idle  last commit {last_date}  {info.path}')


def run_stale(args: argparse.Namespace) -> None:
    repos = resolve_repos(args.paths, args.depth)
    if not repos:
        sys.exit('no git repositories found')

    infos = collect_all_stale(repos, args.workers)
    print_stale_report(infos, args.days)


def git_output(repo: pathlib.Path, args: list[str]) -> str:
    result = run_git(repo, args, timeout=120)
    return result.stdout.strip() if result.returncode == 0 else ''


def analyze_repository(repo: pathlib.Path) -> None:
    print('repository analytics')

    if not git_output(repo, ['rev-parse', '--is-inside-work-tree']):
        sys.exit(f'not a git repository: {repo}')

    total_commits_str = git_output(repo, ['rev-list', '--count', 'HEAD'])
    total_commits = int(total_commits_str) if total_commits_str else 0

    process = subprocess.Popen(
        ['git', 'log', '--numstat', '--pretty=format:COMMIT%x00%ct%x00%an'],
        stdout=subprocess.PIPE,
        text=True,
        errors='replace',
        cwd=repo,
        env=GIT_ENV,
    )

    first_ts = float('inf')
    last_ts = 0
    contributors: dict[str, int] = collections.defaultdict(int)
    file_churn: dict[str, int] = collections.defaultdict(int)
    added_lines = 0
    removed_lines = 0

    for line in process.stdout:
        line = line.strip()
        if not line:
            continue

        if line.startswith('COMMIT\x00'):
            parts = line.split('\x00', maxsplit=2)
            if len(parts) == 3:
                try:
                    ts = int(parts[1])
                except ValueError:
                    continue
                first_ts = min(first_ts, ts)
                last_ts = max(last_ts, ts)
                contributors[parts[2]] += 1
        else:
            parts = line.split(maxsplit=2)
            if len(parts) == 3:
                try:
                    add = int(parts[0]) if parts[0] != '-' else 0
                    rem = int(parts[1]) if parts[1] != '-' else 0
                except ValueError:
                    continue
                added_lines += add
                removed_lines += rem
                file_churn[parts[2]] += 1

    process.wait()

    if first_ts == float('inf'):
        print('no commits found.')
        return

    days_active = max((time.time() - first_ts) / 86400, 1.0)

    print(f'average commits per day: {total_commits / days_active:.2f}')
    print(f'average commits per week: {(total_commits / days_active) * 7:.2f}')
    print(f'average commits per month: {(total_commits / days_active) * 30:.2f}')
    print()
    print(f'number of unique contributors: {len(contributors)}')
    print()
    print('top 10 committers:')
    for author, count in sorted(contributors.items(), key=lambda x: x[1], reverse=True)[:10]:
        print(f'{count:>5}  {author}')

    print()
    print(f'last commit date: {datetime.datetime.fromtimestamp(last_ts)}')
    print(f'first commit date: {datetime.datetime.fromtimestamp(first_ts)}')
    print()
    print('total lines of code added/removed (entire history):')
    print(f'added: {added_lines}')
    print(f'removed: {removed_lines}')
    print(f'net change: {added_lines - removed_lines}')
    print()
    print('top 10 most frequently changed files:')
    for fname, count in sorted(file_churn.items(), key=lambda x: x[1], reverse=True)[:10]:
        print(f'{count:>5} {fname}')

    branches = git_output(repo, ['branch', '-r']).splitlines()
    print()
    print(f'number of active branches: {len(branches)}')

    all_files = git_output(repo, ['ls-files']).splitlines()
    total_files = len(all_files)
    print(f'total number of files: {total_files}')

    if total_files == 0:
        return

    print()
    print('number of files by extension and percentage contribution:')
    extensions: dict[str, int] = collections.defaultdict(int)
    for f in all_files:
        ext = pathlib.Path(f).suffix
        extensions[ext[1:] if ext else '[no extension]'] += 1

    for ext, count in sorted(extensions.items(), key=lambda x: x[1], reverse=True):
        print(f'{count:>5} ({count / total_files * 100:.2f}%) {ext}')


def run_stats(args: argparse.Namespace) -> None:
    if not args.path.exists():
        sys.exit(f'path does not exist: {args.path}')
    if not args.path.is_dir():
        sys.exit(f'path is not a directory: {args.path}')
    analyze_repository(args.path.resolve())


