    parser.add_argument('host', nargs='?', default=GITHUB_HOST, help='host to log out of, default is github.com')
    parser.set_defaults(func=run_logout)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog='gb', description='a multitool for working with git repositories')
    subparsers = parser.add_subparsers(dest='command', required=True)
    add_status_parser(subparsers)
    add_clone_parser(subparsers)
    add_fetch_parser(subparsers)
    add_pull_parser(subparsers)
    add_prune_parser(subparsers)
    add_stale_parser(subparsers)
    add_stats_parser(subparsers)
    add_login_parser(subparsers)
    add_logout_parser(subparsers)
    return parser


def main() -> None:
    args = build_parser().parse_args()
    args.func(args)


if __name__ == '__main__':
    main()
