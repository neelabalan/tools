class DevEnvironmentConfig:
    DISTROS: dict[str, DistroConfig] = {}
    TOOLS: dict[str, ToolSpec] = {}
    PROFILES: dict[str, dict[str, typing.Any]] = {}

    @classmethod
    def load(cls, path: pathlib.Path) -> None:
        config = load_config(path)
        cls.DISTROS = config.distros
        cls.TOOLS = config.tools
        cls.PROFILES = config.profiles

    @classmethod
    def from_profile(cls, profile: str) -> 'DevEnvironmentConfig':
        profile_data = cls.PROFILES.get(profile)
        if not profile_data:
            available = list(cls.PROFILES.keys())
            raise ValueError(f"profile '{profile}' not found. available profiles: {available}")

        required = {'distro': 'distro', 'arch': 'arch', 'container_user': 'user'}
        missing = [prop for key, prop in required.items() if key not in profile_data]
        if missing:
            raise ValueError(f"profile '{profile}' is missing: {', '.join(missing)}")

        return cls(
            distro=profile_data['distro'],
            arch=profile_data['arch'],
            username=profile_data['container_user'],
            profile=profile,
        )

    def __init__(
        self,
        distro: str,
        arch: str,
        username: str,
        profile: str | None = None,
    ) -> None:
        self.distro = distro
        self.username = username
        self.profile = profile
        self.host_arch = arch

        self._setup_distro_config()
        self.conf = self._generate_conf()

    def get_profile_data(self) -> dict[str, typing.Any]:
        if self.profile and self.profile in self.PROFILES:
            return self.PROFILES[self.profile]
        return {}

    def build_device_steps(self) -> list[tuple[list[str], str]]:
        return [
            (tool.build_devices, command)
            for tool in self.conf.values()
            for command, uses_device in zip(tool.setup, tool.setup_uses_build_device, strict=True)
            if uses_device
        ]

    def _setup_distro_config(self) -> None:
        if self.distro not in self.DISTROS:
            raise ValueError(f'unsupported distro: {self.distro}. supported: {list(self.DISTROS.keys())}')

        self.current_distro_config = self.DISTROS[self.distro]

    def _generate_conf(self) -> dict[str, Tool]:
        pkg = self.current_distro_config
        effective_arch = f'{pkg.arch_prefix}{self.host_arch}'

        all_tools: dict[str, Tool] = {
            name: Tool(
                setup=[self._resolve_step(pkg, spec, kind, value, effective_arch) for kind, value in spec.install],
                setup_uses_build_device=[kind == 'run-with-build-device' for kind, _ in spec.install],
                depends_on=spec.depends_on,
                env=spec.env,
                copy=spec.copy,
                build_devices=self.get_profile_data().get('build_devices', []),
            )
            for name, spec in self.TOOLS.items()
        }

        if self.profile and self.profile in self.PROFILES:
            profile_data = self.PROFILES[self.profile]
            tools_to_include = profile_data.get('tools', [])
            resolved_order = resolve_dependencies(all_tools, tools_to_include)
            uses_build_device = any(
                any(all_tools[name].setup_uses_build_device) for name in resolved_order
            )
            if uses_build_device and not profile_data.get('build_devices'):
                raise ValueError(f"profile '{self.profile}' uses run-with-build-device but has no build-device")
            return {name: all_tools[name] for name in resolved_order}

        return all_tools

    def copies(self) -> list[dict[str, str]]:
        return [item for tool in self.conf.values() for item in tool.copy]

    def _resolve_step(self, pkg: DistroConfig, spec: ToolSpec, kind: str, value: str, effective_arch: str) -> str:
        match kind:
            case 'script':
                if value not in pkg.scripts:
                    raise ValueError(f'distro {pkg.name} has no script: {value}')
                return pkg.scripts[value]
            case 'run' | 'run-with-build-device':
                arch = spec.arch_map.get(effective_arch, '')
                return string.Template(value).safe_substitute(
                    version=spec.version, arch=arch, profile=self.profile or ''
                )
            case _:
                raise ValueError(f'unknown install step: {kind}')


def normalize_indent_after_first_line(s: str, indent: int = 4) -> str:
    lines = s.splitlines()
    if not lines:
        return s

    first_line = lines[0]
    rest_lines = lines[1:]

    normalized = [first_line]
    for line in rest_lines:
        if line.strip() == '':
            normalized.append('')
        else:
            normalized.append(' ' * indent + line.lstrip())

    return '\n'.join(normalized)


class DockerfileBuilder:
    DOCKERFILE_BASE_TEMPLATE = textwrap.dedent("""
        # NOTE: This Dockerfile is generated. Do not edit manually.
        FROM <$>base_image
        SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
        ENV SHELL=/bin/bash

        RUN <$>mirror_configure && \\
            <$>update && \\
            <$>install_base

        ARG USERNAME=<$>username
        ARG USER_UID=1000
        ARG USER_GID=$USER_UID

        RUN groupadd --gid $USER_GID $USERNAME \\
            && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \\
            && echo $USERNAME ALL=\\(root\\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \\
            && chmod 0440 /etc/sudoers.d/$USERNAME

        USER $USERNAME

        WORKDIR <$>workdir

        ENV HOME=<$>workdir

        <$>tool_stages

        # SecretsUsedInArgOrEnv: Do not use ARG or ENV instructions for sensitive data
        ARG PASSWORD=admin
        RUN echo "${USERNAME}:${PASSWORD}" | sudo chpasswd
    """)

    def __init__(self, config: DevEnvironmentConfig) -> None:
        self.config = config
        self.tools = config.conf
        self.engine = ContainerEngine.engine()
        self.docker_template = self._setup_docker_template()

    def _setup_docker_template(self) -> DockerfileTemplate:
        base_template = DockerfileTemplate(textwrap.dedent(self.DOCKERFILE_BASE_TEMPLATE).strip())
        cfg = self.config.current_distro_config

        return DockerfileTemplate(
            base_template.safe_substitute(
                base_image=cfg.base_image,
                mirror_configure=cfg.scripts['mirror'],
                update=cfg.update_cmd,
                install_base=cfg.install_nosudo('sudo', *cfg.base_packages()),
                username=self.config.username,
                workdir='/home/$USERNAME',
            )
        )

    def build_tool_stage(self, name: str, tool: Tool) -> str:
        buf = io.StringIO()
        buf.write(f'# stage: {shlex.quote(name)}\n')

        if tool.env:
            buf.write(f'# setting Env for {name}\n')
            for env_item in tool.env:
                for key, val in env_item.items():
                    buf.write(f'ENV {key}={val}\n')
            buf.write('\n')

        if tool.copy:
            buf.write(f'# WARNING: files copied for {name} are baked into this image and can be extracted\n')
            buf.write(f'# file copy for {name}\n')
            for copy_item in tool.copy:
                buf.write(f'COPY --chown=$USERNAME:$USERNAME {copy_item["destination"]} {copy_item["destination"]}\n')

        if tool.setup:
            for index, setup_cmd in enumerate(tool.setup):
                uses_build_device = tool.setup_uses_build_device[index]
                device_flags = ''
                if uses_build_device and self.engine == 'docker':
                    device_flags = ''.join(f' --device={device}' for device in tool.build_devices)
                buf.write(f'RUN{device_flags} {normalize_indent_after_first_line(setup_cmd)}\n')
            buf.write('\n')

        return buf.getvalue()

    def build(self) -> str:
        stages = []
        for name, tool in self.tools.items():
            stages.append(self.build_tool_stage(name, tool))
        dockerfile = self.docker_template.substitute(tool_stages='\n'.join(stages))
        if self.engine == 'docker' and any(
            any(tool.setup_uses_build_device) for tool in self.tools.values()
        ):
            return '# syntax=docker/dockerfile:1-labs\n\n' + dockerfile
        return dockerfile


class SetupShBuilder:
    def _get_header(self, profile: str, distro: str, arch: str) -> str:
        return textwrap.dedent(f"""
            #!/bin/bash
            set -euo pipefail

            # generated setup script for profile: {profile}
            # distro: {distro}, arch: {arch}

            RED='\\033[0;31m'
            GREEN='\\033[0;32m'
            YELLOW='\\033[0;33m'
            NC='\\033[0m'

            log_info() {{ echo -e "${{GREEN}}[info]${{NC}} $1"; }}
            log_warn() {{ echo -e "${{YELLOW}}[warn]${{NC}} $1"; }}
            log_error() {{ echo -e "${{RED}}[error]${{NC}} $1" >&2; }}

            # ensure local bin directory exists
            mkdir -p "$HOME/.local/bin"
            export PATH="$HOME/.local/bin:$PATH"

            # use temp directory for downloads
            TMPDIR=$(mktemp -d)
            trap "rm -rf $TMPDIR" EXIT
            cd "$TMPDIR"

            TOOLS_TO_INSTALL=()
            INSTALL_ALL=false
        """)

    SETUP_SH_MAIN = textwrap.dedent("""
        print_usage() {
            echo "usage: $0 [options] [tool1 tool2 ...]"
            echo ""
            echo "options:"
            echo "  --all        install all tools"
            echo "  --list       list available tools"
            echo "  --help       show this help"
            echo ""
            echo "available tools:"
            for tool in "${!TOOL_FUNCTIONS[@]}"; do
                echo "  $tool"
            done | sort
        }

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --all)
                    INSTALL_ALL=true
                    shift
                    ;;
                --list)
                    echo "available tools:"
                    for tool in "${!TOOL_FUNCTIONS[@]}"; do
                        echo "  $tool"
                    done | sort
                    exit 0
                    ;;
                --help|-h)
                    print_usage
                    exit 0
                    ;;
                -*)
                    log_error "unknown option: $1"
                    print_usage
                    exit 1
                    ;;
                *)
                    TOOLS_TO_INSTALL+=("$1")
                    shift
                    ;;
            esac
        done

        if [[ "$INSTALL_ALL" == true ]]; then
            TOOLS_TO_INSTALL=("${ALL_TOOLS[@]}")
        fi

        if [[ ${#TOOLS_TO_INSTALL[@]} -eq 0 ]]; then
            print_usage
            exit 1
        fi

        log_info "installing base packages..."
        eval "$BASE_INSTALL"

        for tool in "${TOOLS_TO_INSTALL[@]}"; do
            if [[ -n "${TOOL_FUNCTIONS[$tool]:-}" ]]; then
                log_info "installing $tool..."
                eval "${TOOL_FUNCTIONS[$tool]}"
                log_info "$tool installed"
            else
                log_error "unknown tool: $tool"
                exit 1
            fi
        done

        log_info "setup complete!"
    """)

    def __init__(self, config: DevEnvironmentConfig) -> None:
        self.config = config
        self.tools = config.conf

    def _escape_for_bash(self, cmd: str) -> str:
        # escape single quotes for embedding in bash single-quoted string
        return cmd.replace("'", "'\"'\"'")

    def build_tool_entry(self, name: str, tool: Tool) -> str:
        commands = []
        for copy_item in tool.copy:
            destination = f'"$HOME/{copy_item["destination"]}"'
            commands.append(f'mkdir -p "$(dirname {destination})"')
            commands.append(f'cp {shlex.quote(str(pathlib.Path(copy_item["source"]).expanduser()))} {destination}')
        commands.extend(tool.setup)

        if not commands:
            commands = ['true']

        combined = ' && '.join(commands)
        escaped = self._escape_for_bash(combined)
        return f"[{name}]='{escaped}'"

    def build(self) -> str:
        buf = io.StringIO()

        # header
        header = self._get_header(
            profile=self.config.profile or 'unknown',
            distro=self.config.distro,
            arch=self.config.host_arch,
        )
        buf.write(header)

        base_install = self.config.current_distro_config.install(*self.config.current_distro_config.base_packages())
        buf.write(f'\nBASE_INSTALL={shlex.quote(base_install)}\n')

        # tool functions as associative array
        buf.write('\ndeclare -A TOOL_FUNCTIONS\n')
        for name, tool in self.tools.items():
            buf.write(f'TOOL_FUNCTIONS{self.build_tool_entry(name, tool)}\n')

        # all tools array (preserves order)
        tool_names = ' '.join(f'"{name}"' for name in self.tools.keys())
        buf.write(f'\nALL_TOOLS=({tool_names})\n')

        # main script
        buf.write(self.SETUP_SH_MAIN)

        return buf.getvalue()


class ArtifactRepository:
    def __init__(self, output_dir: pathlib.Path = CACHE_DIR):
        self.output_dir = output_dir
        self.output_dir.mkdir(parents=True, exist_ok=True)
        self.logs_dir = self.output_dir / 'logs'
        self.logs_dir.mkdir(parents=True, exist_ok=True)
        self.main_log_file = self.logs_dir / 'dnv.log'
        if not self.main_log_file.exists():
            try:
                self.main_log_file.touch()
            except Exception as e:
                logger.debug(f'could not create main log file: {e}')

    def save_artifact(self, content: str, filename: str) -> pathlib.Path:
        filepath = self.output_dir / filename
        filepath.parent.mkdir(parents=True, exist_ok=True)
        filepath.write_text(content)
        return filepath

    def save_logs(self, log_content: str, log_name: str | None = None) -> pathlib.Path:
        # always append to unified log file
        section = log_name or 'section'
        try:
            with self.main_log_file.open('a', encoding='utf-8') as fh:
                fh.write('\n' + ('-' * 60) + f'\n[{section.upper()}] {datetime.datetime.now().isoformat()}\n')
                fh.write(log_content.rstrip() + '\n')
        except Exception as e:
            logger.error(f'failed writing logs: {e}')
        return self.main_log_file


class ImageBuilder:
    def __init__(
        self,
        name: str,
        dockerfile_path: pathlib.Path,
        arch: str | None = None,
        copies: list[dict[str, str]] | None = None,
        build_device_steps: list[tuple[list[str], str]] | None = None,
    ) -> None:
        self.name = name
        self.dockerfile_path = dockerfile_path
        self.arch = arch
        self.copies = copies or []
        self.build_device_steps = build_device_steps or []
        self.engine: str | None = None

    @staticmethod
    def get_image_tag(config: DevEnvironmentConfig) -> str:
        return f'dnv-{config.profile}-{config.distro}-{config.host_arch}:latest'

    def _image_exists(self, image_name: str) -> bool:
        return bool(
            subprocess.run(
                ContainerEngine.cmd('images', '-q', image_name), capture_output=True, text=True
            ).stdout.strip()
        )

    def is_built(self) -> bool:
        return self._image_exists(self.name)

    def _stage_context(self) -> None:
        # WARNING: files listed in `copy` (e.g. ssh keys) are baked into the image layers.
        # They are staged in CONTEXT_DIR only for the duration of the build and removed after.
        CONTEXT_DIR.mkdir(parents=True, exist_ok=True)
        for item in self.copies:
            target = CONTEXT_DIR / item['destination']
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(pathlib.Path(item['source']).expanduser(), target)

    def build(self) -> bool:
        shutil.rmtree(CONTEXT_DIR, ignore_errors=True)
        try:
            self._stage_context()
        except OSError as e:
            logger.error(f'failed to stage copy sources: {e}')
            shutil.rmtree(CONTEXT_DIR, ignore_errors=True)
            return False
        try:
            return self._run_build()
        finally:
            shutil.rmtree(CONTEXT_DIR, ignore_errors=True)

    def _run_build(self) -> bool:
        logger.info(f'building image: {self.name}')

        self.engine = ContainerEngine.engine()
        if self.build_device_steps and self.engine not in {'docker', 'podman'}:
            logger.error(f'build-time devices are not supported with {self.engine}')
            return False

        build_cmd = ContainerEngine.cmd('build')
        if self.build_device_steps and self.engine == 'docker':
            devices = dict.fromkeys(
                device for step_devices, _ in self.build_device_steps for device in step_devices
            )
            for device in devices:
                build_cmd.extend(['--allow', f'device={device}'])
        elif self.build_device_steps and self.engine == 'podman':
            devices = dict.fromkeys(
                device for step_devices, _ in self.build_device_steps for device in step_devices
            )
            for device in devices:
                build_cmd.extend(['--device', device])
        build_cmd.extend(['-t', self.name, '-f', str(self.dockerfile_path)])

        if self.arch:
            build_cmd.extend(get_docker_platform_flag(self.arch))

        if logger.isEnabledFor(logging.DEBUG):
            build_cmd.append('--progress=plain')
            if not self.build_device_steps:
                build_cmd.append('--no-cache')

        if self.build_device_steps:
            # The llama installer selects a binary from the visible GPU; don't reuse
            # a cached result that may have been selected on a different build host.
            build_cmd.append('--no-cache')

        build_cmd.append(str(CONTEXT_DIR))
        logger.debug(f'running: {" ".join(build_cmd)}')

        artifact_repo = ArtifactRepository()

        stdout_output: str
        stderr_output: str
        returncode: int

        if logger.isEnabledFor(logging.DEBUG):
            logger.info(f'Debug mode: showing verbose {ContainerEngine.engine()} build output...')
            debug_result = subprocess.run(build_cmd, cwd=str(CONTEXT_DIR))
            returncode = debug_result.returncode
            stdout_output = stderr_output = 'Live output shown above'
        else:
            text_result = subprocess.run(build_cmd, capture_output=True, text=True, cwd=str(CONTEXT_DIR))
            returncode = text_result.returncode
            stdout_output = text_result.stdout
            stderr_output = text_result.stderr

        log_content = (
            f'Command: {" ".join(build_cmd)}\n'
            f'Return code: {returncode}\n'
            f'STDOUT:\n{stdout_output}\n'
            f'STDERR:\n{stderr_output}\n'
        )
        artifact_repo.save_logs(log_content, log_name='container-build')

        if returncode != 0:
            logger.error(f'failed to build image {self.name}: {stderr_output.strip()}')
            return False
        logger.info(f'successfully built image: {self.name}')

        self._cleanup_dangling_images()
        return True

    def _cleanup_dangling_images(self) -> None:
        try:
            logger.debug('cleaning up dangling images...')
            result = subprocess.run(ContainerEngine.image_prune_cmd(), capture_output=True, text=True)
            if result.returncode == 0 and result.stdout.strip():
                logger.info('cleaned up dangling images')
                logger.debug(f'cleanup output: {result.stdout.strip()}')
        except Exception as e:
            logger.debug(f'failed to clean up dangling images: {e}')


class DevContainerManager:
    @staticmethod
    def is_running(container_id: str) -> bool:
        if not container_id:
            return False
        result = subprocess.run(
            ContainerEngine.cmd('inspect', '--format', '{{.State.Running}}', container_id),
            capture_output=True,
            text=True,
        )
        return result.returncode == 0 and result.stdout.strip() == 'true'

    @staticmethod
    def start(image_name: str, name: str | None, docker_config: dict[str, typing.Any], arch: str | None = None) -> None:
        cmd = ContainerEngine.cmd('run', '-it', '--label', 'devenv=true')

        # Add platform flag if cross-platform run is needed
        if arch:
            cmd.extend(get_docker_platform_flag(arch))

        if name:
            cmd.extend(['--name', name, '--label', f'devenv.container={name}'])

        for port in docker_config.get('exposed_ports', []):
            cmd.extend(['-p', f'{port}:{port}'])

        for volume in docker_config.get('volumes', []):
            source = pathlib.Path(volume['source']).expanduser().resolve()
            target = volume['target']
            mode = volume.get('mode', 'rw')
            cmd.extend(['-v', f'{source}:{target}:{mode}'])

        cmd.extend(docker_config.get('run_args', []))

        cmd.append(image_name)
        cmd.append('bash')
        logger.info(f'starting container: {" ".join(cmd)}')

        # replace the current python process with container engine - this exits Python
        # and drops directly into the interactive container
        os.execvp(ContainerEngine.engine(), cmd)

    @staticmethod
    def stop(container_id: str) -> bool:
        if not container_id:
            return False
        result = subprocess.run(ContainerEngine.cmd('stop', container_id), capture_output=True)
        return result.returncode == 0

    @staticmethod
    def remove(container_id: str) -> bool:
        if not container_id:
            return False
        result = subprocess.run(ContainerEngine.cmd('rm', container_id), capture_output=True, text=True)
        if result.returncode == 0:
            logger.info(f"container '{container_id}' removed successfully")
            return True
        else:
            logger.error(f"failed to remove container '{container_id}': {result.stderr.strip()}")
            return False

    @staticmethod
    def start_existing_container(container_name: str) -> bool:
        if not container_name:
            return False
        result = subprocess.run(ContainerEngine.cmd('start', container_name), capture_output=True, text=True)
        if result.returncode == 0:
            logger.info(f"container '{container_name}' started successfully")
            return True
        else:
            logger.error(f"failed to start container '{container_name}': {result.stderr.strip()}")
            return False

    @staticmethod
    def container_exists(container_name: str) -> bool:
        if not container_name:
            return False
        result = subprocess.run(
            ContainerEngine.cmd('inspect', '--format', '{{.State.Status}}', container_name),
            capture_output=True,
            text=True,
        )
        return result.returncode == 0

    @staticmethod
    def exec_shell(container_id: str, shell: str = '/bin/bash') -> None:
        if not container_id:
            logger.warning('no container ID available')
            return
        result = subprocess.run(ContainerEngine.cmd('exec', '-it', container_id, shell))
        if result.returncode != 0:
            logger.error(f"failed to login to container '{container_id}' (ensure running)")

    @staticmethod
    def remove_volumes(container_name: str) -> bool:
        volume_result = subprocess.run(
            ContainerEngine.cmd(
                'volume',
                'ls',
                '--filter',
                f'label=devenv.container={container_name}',
                '-q',
            ),
            capture_output=True,
            text=True,
        )

        if volume_result.stdout.strip():
            volumes = volume_result.stdout.strip().split('\n')
            for volume in volumes:
                vol_del_result = subprocess.run(ContainerEngine.cmd('volume', 'rm', volume), capture_output=True)
                if vol_del_result.returncode == 0:
                    logger.info(f"volume '{volume}' removed")
                else:
                    logger.error(f"failed to remove volume '{volume}'")
            return True
        return False

    @staticmethod
    def list_deployments() -> None:
        result = subprocess.run(
            ContainerEngine.cmd(
                'ps',
                '-a',
                '--filter',
                'label=devenv=true',
                '--format',
                'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}',
            ),
            capture_output=True,
            text=True,
        )

        if result.returncode == 0:
            logger.info('devenv deployments:')
            for line in result.stdout.strip().splitlines():
                logger.info(f'{line}')
        else:
            logger.error(f'error listing deployments: {result.stderr.strip()}')


def get_dockerfile_name(config: DevEnvironmentConfig) -> pathlib.Path:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    return CACHE_DIR / f'Dockerfile.{config.profile}.{config.distro}.{config.host_arch}'


class CommandHandler:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.artifact_repo = ArtifactRepository()

    def handle_spin(self) -> None:
        if self.args.profile not in DevEnvironmentConfig.PROFILES:
            available = list(DevEnvironmentConfig.PROFILES.keys())
            logger.error(f"profile '{self.args.profile}' not found. Available: {available}")
            sys.exit(1)

        config = DevEnvironmentConfig.from_profile(self.args.profile)
        dockerfile_path = get_dockerfile_name(config)

        image_name = ImageBuilder.get_image_tag(config)
        image_builder = ImageBuilder(
            image_name,
            dockerfile_path,
            config.host_arch,
            copies=config.copies(),
            build_device_steps=config.build_device_steps(),
        )

        if self.args.rebuild:
            logger.info(f'rebuilding image: {image_name}...')
            self.artifact_repo.save_artifact(DockerfileBuilder(config).build(), dockerfile_path.name)
            if not image_builder.build():
                logger.error('failed to build image')
                sys.exit(1)
        elif not image_builder.is_built():
            logger.info(f'image {image_name} not found, building...')
            self.artifact_repo.save_artifact(DockerfileBuilder(config).build(), dockerfile_path.name)
            if not image_builder.build():
                logger.error('failed to build image')
                sys.exit(1)
        else:
            logger.info(f'using existing image: {image_name}')

        # This call will replace the current Python process with the Docker command
        # and never return - the user will be dropped directly into the container
        DevContainerManager.start(image_name, self.args.name, config.get_profile_data(), config.host_arch)

    def handle_build(self) -> None:
        if self.args.profile not in DevEnvironmentConfig.PROFILES:
            available = list(DevEnvironmentConfig.PROFILES.keys())
            logger.error(f"profile '{self.args.profile}' not found. Available: {available}")
            sys.exit(1)

        config = DevEnvironmentConfig.from_profile(self.args.profile)
        dockerfile_path = get_dockerfile_name(config)
        self.artifact_repo.save_artifact(DockerfileBuilder(config).build(), str(dockerfile_path))

        image_name = ImageBuilder.get_image_tag(config)
        image_builder = ImageBuilder(
            image_name,
            dockerfile_path,
            config.host_arch,
            copies=config.copies(),
            build_device_steps=config.build_device_steps(),
        )
        if not image_builder.build():
            logger.error('failed to build image')
            sys.exit(1)
        logger.info(f"image '{image_name}' built successfully")

    def handle_craft(self) -> None:
        if self.args.profile not in DevEnvironmentConfig.PROFILES:
            available = list(DevEnvironmentConfig.PROFILES.keys())
            logger.error(f"profile '{self.args.profile}' not found. Available: {available}")
            sys.exit(1)

        config = DevEnvironmentConfig.from_profile(self.args.profile)

        # determine output format
        output_format = self.args.format or ('dockerfile' if config.current_distro_config.base_image else 'shell')

        if output_format == 'shell':
            script_content = SetupShBuilder(config).build()
            filename = f'setup.{config.profile}.{config.distro}.{config.host_arch}.sh'
            saved_path = self.artifact_repo.save_artifact(script_content, filename)
            logger.info(f'setup script written to: {saved_path}')
        else:
            if not config.current_distro_config.base_image:
                logger.error(f'distro {config.distro} has no base-image, use --format shell')
                sys.exit(1)
            dockerfile_content = DockerfileBuilder(config).build()
            filename = f'Dockerfile.{config.profile}.{config.distro}.{config.host_arch}'
            saved_path = self.artifact_repo.save_artifact(dockerfile_content, filename)
            logger.info(f'Dockerfile written to: {saved_path}')

    def handle_ls(self) -> None:
        DevContainerManager.list_deployments()

    def handle_rm(self) -> None:
        for name in self.args.names:
            logger.info(f"removing container '{name}'...")
            DevContainerManager.stop(name)
            success = DevContainerManager.remove(name)

            if success and self.args.volumes:
                DevContainerManager.remove_volumes(name)

            if not success:
                logger.error(f"failed to remove container '{name}'")
            else:
                logger.info(f"successfully removed '{name}'")

    def handle_shell(self) -> None:
        container_name = self.args.name

        if not container_name:
            logger.error('container name required for shell command')
            return

        if not DevContainerManager.container_exists(container_name):
            logger.error(f"container '{container_name}' does not exist")
            return

        if not DevContainerManager.is_running(container_name):
            logger.info(f"container '{container_name}' not running; starting...")
            if not DevContainerManager.start_existing_container(container_name):
                return

        time.sleep(1)

        DevContainerManager.exec_shell(container_name, self.args.shell)

    def handle(self) -> None:
        match self.args.command:
            case 'build':
                self.handle_build()
            case 'spin':
                self.handle_spin()
            case 'craft':
                self.handle_craft()
            case 'ls':
                self.handle_ls()
            case 'rm':
                self.handle_rm()
            case 'shell':
                self.handle_shell()
            case _:
                print('command not supported')


def main() -> None:
    parser = argparse.ArgumentParser(
        description='Development environment manager using containers',
        epilog="""
Commands:
  spin      Build (if needed) and start an interactive container from a profile
  build     Build container image from a profile without starting it
  craft     Generate Dockerfile from a profile without building
  ls        List all devenv containers (running and stopped)
  rm        Remove one or more devenv containers
  shell     Open a shell in an existing container

Examples:
  %(prog)s spin --profile python-minimal           Start minimal Python environment
  %(prog)s spin --profile workstation --name dev   Start with custom container name
  %(prog)s build --profile workstation             Build image without starting
  %(prog)s craft --profile workstation             Generate Dockerfile only
  %(prog)s ls                                      List all devenv containers
  %(prog)s shell mycontainer                       Shell into existing container
  %(prog)s rm mycontainer                          Remove a container
  %(prog)s rm container1 container2 --volumes      Remove containers and volumes

Use --config to point at a different config file (default: dnv.kdl next to this script)

Environment:
  DEBUG=1            Enable debug logging with file output to ~/.cache/dnv/logs/
  CONTAINER_ENGINE   Override container engine detection (docker or podman)
        """,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        '--config',
        type=pathlib.Path,
        default=_CONFIG_DIR / 'dnv.kdl',
        help='config file with distros, packages and profiles (default: dnv.kdl next to this script)',
    )
    subparsers = parser.add_subparsers(dest='command', help='available commands')

    # spin command args
    spin_parser = subparsers.add_parser('spin', help='build and start interactive container')
    spin_parser.add_argument(
        '--profile',
        required=True,
        help='profile name to use',
    )
    spin_parser.add_argument('--name', help='container name')
    spin_parser.add_argument('--rebuild', action='store_true', help='force rebuild the image from a fresh Dockerfile')

    # build command args
    build_parser = subparsers.add_parser('build', help='build development environment')
    build_parser.add_argument(
        '--profile',
        required=True,
        help='profile name to use',
    )

    # craft command args
    craft_parser = subparsers.add_parser('craft', help='generate Dockerfile or shell script')
    craft_parser.add_argument(
        '--profile',
        required=True,
        help='profile name to use',
    )
    craft_parser.add_argument(
        '--format',
        choices=['dockerfile', 'shell'],
        default=None,
        help='output format: dockerfile or shell (default: dockerfile if the distro has a base-image, else shell)',
    )

    # ls command args
    subparsers.add_parser('ls', help='list containers')

    # rm command args
    rm_parser = subparsers.add_parser('rm', help='remove container(s)')
    rm_parser.add_argument('names', nargs='+', help='container name(s) to remove')
    rm_parser.add_argument('--volumes', action='store_true', help='also delete volumes')

    # shell command args
    shell_parser = subparsers.add_parser('shell', help='shell into container')
    shell_parser.add_argument('name', help='container name')
    shell_parser.add_argument('--shell', default='/bin/bash', help='shell to use')

    args = parser.parse_args()
    DevEnvironmentConfig.load(args.config)

    if args.command is None:
        parser.print_help()
        print('\navailable profiles:')
        for profile_name, profile_data in DevEnvironmentConfig.PROFILES.items():
            print(f'- {profile_name}:')
            if 'distro' in profile_data:
                distro = profile_data['distro']
                if distro in DevEnvironmentConfig.DISTROS:
                    base_image = DevEnvironmentConfig.DISTROS[distro].base_image
                    print(f'  distro: {distro} ({base_image})')
                else:
                    print(f'  distro: {distro} (invalid)')
            if 'tools' in profile_data:
                tools = profile_data['tools']
                print(f'  tools: {", ".join(tools)}')
            print()
        return

    CommandHandler(args).handle()


if __name__ == '__main__':
    main()
