    arch "x86_64" "linux-amd64"
    arch "aarch64" "linux-arm64"
    arch "darwin-aarch64" "darwin-arm64"
    install {
        run #"""
            curl -LO https://get.helm.sh/helm-v$version-$arch.tar.gz && \
            tar -xzf helm-v$version-$arch.tar.gz && \
            mv $arch/helm $HOME/.local/bin/ && \
            rm -rf $arch helm-v$version-$arch.tar.gz
            """#
    }
}

package "hurl" version="5.0.1" {
    arch "x86_64" "x86_64-unknown-linux-gnu"
    arch "aarch64" "aarch64-unknown-linux-gnu"
    arch "darwin-aarch64" "aarch64-apple-darwin"
    install {
        run #"""
            curl -LO https://github.com/Orange-OpenSource/hurl/releases/download/$version/hurl-$version-$arch.tar.gz && \
            tar -xzf hurl-$version-$arch.tar.gz && \
            mv hurl-$version-$arch/bin/hurl $HOME/.local/bin/ && \
            rm -rf hurl-$version-$arch*
            """#
    }
}

package "zoxide" version="0.9.6" {
    arch "x86_64" "x86_64-unknown-linux-musl"
    arch "aarch64" "aarch64-unknown-linux-musl"
    arch "darwin-aarch64" "aarch64-apple-darwin"
    install {
        run #"""
            curl -LO https://github.com/ajeetdsouza/zoxide/releases/download/v$version/zoxide-$version-$arch.tar.gz && \
            tar -xzf zoxide-$version-$arch.tar.gz && \
            mv zoxide $HOME/.local/bin/ && \
            rm zoxide-$version-$arch.tar.gz
            """#
    }
}

package "yazi" version="0.4.2" {
    arch "x86_64" "x86_64-unknown-linux-musl"
    arch "aarch64" "aarch64-unknown-linux-musl"
    arch "darwin-aarch64" "aarch64-apple-darwin"
    install {
        run #"""
            curl -LO https://github.com/sxyazi/yazi/releases/download/v$version/yazi-$arch.zip && \
            unzip -o yazi-$arch.zip && \
            mv yazi-$arch/yazi $HOME/.local/bin/ && \
            rm -rf yazi-$arch*
            """#
    }
}

package "typst" version="0.12.0" {
    arch "x86_64" "x86_64-unknown-linux-musl"
    arch "aarch64" "aarch64-unknown-linux-musl"
    arch "darwin-aarch64" "aarch64-apple-darwin"
    install {
        run #"""
            curl -LO https://github.com/typst/typst/releases/download/v$version/typst-$arch.tar.xz && \
            tar -xJf typst-$arch.tar.xz && \
            mv typst-$arch/typst $HOME/.local/bin/ && \
            rm -rf typst-$arch*
            """#
    }
}

package "tree-sitter" version="0.24.5" {
    arch "x86_64" "linux-x64"
    arch "aarch64" "linux-arm64"
    arch "darwin-aarch64" "macos-arm64"
    install {
        run #"""
            curl -LO https://github.com/tree-sitter/tree-sitter/releases/download/v$version/tree-sitter-$arch.gz && \
            gunzip tree-sitter-$arch.gz && \
            chmod +x tree-sitter-$arch && \
            mv tree-sitter-$arch $HOME/.local/bin/tree-sitter
            """#
    }
}

package "kubectl" version="v1.33.1" {
    arch "x86_64" "linux/amd64"
    arch "aarch64" "linux/arm64"
    arch "darwin-aarch64" "darwin/arm64"
    install {
        run #"""
            curl -LO https://dl.k8s.io/release/$version/bin/$arch/kubectl && \
            chmod +x kubectl && mv kubectl $HOME/.local/bin/kubectl
            """#
    }
}

// WARNING: `copy` bakes the files below into the image layers. Anyone with the image
// can extract the private key. This is an accepted risk for this package; do not
// copy secrets into images you share or push to a registry.
package "ssh" {
    copy "~/.ssh/id_rsa" ".ssh/id_rsa"
    copy "~/.ssh/known_hosts" ".ssh/known_hosts"
    install {
        run #"""
            sudo sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
            sudo sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
            sudo sed -i 's/^#*UsePAM.*/UsePAM yes/' /etc/ssh/sshd_config && \
            sudo ssh-keygen -A
            """#
    }
}

package "docker" version="28.3.3" {
    arch "x86_64" "x86_64"
    arch "aarch64" "aarch64"
    install {
        run "mkdir -p $HOME/.local/bin && curl -fsSL https://download.docker.com/linux/static/stable/$arch/docker-$version.tgz | tar -xz --strip-components=1 -C $HOME/.local/bin docker/docker"
    }
}

package "llama.cpp" {
    install {
        run-with-build-device "curl -LsSf https://llama.app/install.sh | sh"
    }
}

package "dotsync" version="0.0.4" {
    arch "x86_64" "linux-x86_64"
    arch "aarch64" "linux-aarch64"
    arch "darwin-aarch64" "darwin-aarch64"
    install {
        run "curl -L https://github.com/neelabalan/tools/releases/download/dotsync-v$version/dotsync-$arch.tar.gz | tar xz"
        run "mv dotsync $HOME/.local/bin/"
    }
}

package "dotfiles" {
    requires "dotsync" "ssh"
    install {
        run "curl -fsSL https://raw.githubusercontent.com/neelabalan/dotfiles/refs/heads/master/dotsync.json -o $HOME/dotsync.json"
        run "dotsync init --config $HOME/dotsync.json"
        run "dotsync setup --profile $profile"
    }
}

package "cleanup" {
    install {
        script "clean"
    }
}

// SECTION: profiles  (named environments built from distros and packages)

// profiles: named environments built from the distros and packages above
//
// profile  distro, arch, user, ports, volumes, tools, run-args, build-device
//   run-args       additional container runtime arguments
//   build-device   CDI selector for marked steps (Podman passes it to the build globally)

profile "just-dotfiles" distro="alma" arch="x86_64" user="blue"

profile "workstation" distro="alma" arch="x86_64" user="blue" {
    volume source="~/.ssh" target="/home/blue/.ssh" mode="ro"
    tools "python" "node" "rust" "go" "sdkman" "neovim" "starship" "fzf" "ripgrep" "tokei" "eza" \
        "kubectl" "ipython" "ranger" "ssh" "docker" "dotfiles"
}

profile "workstation-gpu" distro="alma" arch="x86_64" user="blue" {
    volume source="~/.ssh" target="/home/blue/.ssh" mode="ro"
    build-device "nvidia.com/gpu=all"
    tools "python" "node" "rust" "go" "sdkman" "neovim" "starship" "fzf" "ripgrep" "tokei" "eza" \
        "kubectl" "ipython" "ranger" "ssh" "docker" "dotfiles" "llama.cpp"
}

profile "workstation-arm" distro="alma" arch="aarch64" user="blue" {
    volume source="~/.ssh" target="/home/blue/.ssh" mode="ro"
    tools "python" "node" "rust" "go" "sdkman" "neovim" "starship" "fzf" "ripgrep" "tokei" "eza" \
        "kubectl" "ipython" "ranger" "ssh" "docker" "dotfiles"
}

profile "python-minimal" distro="alma" arch="x86_64" user="blue" {
    expose 8000
    volume source="~/code" target="/home/blue/code" mode="rw"
    tools "python" "fzf" "ripgrep" "ipython" "dotfiles"
}

profile "python-minimal-arm" distro="alma" arch="aarch64" user="blue" {
    expose 8000
    volume source="~/code" target="/home/blue/code" mode="rw"
    tools "python" "fzf" "ripgrep" "ipython" "dotfiles"
}

profile "ml-cuda" distro="cuda" arch="x86_64" user="developer" {
    working-directory "/home/developer/workspace"
    volume source="./ml-workspace" target="/home/developer/workspace" mode="rw"
    tools "python" "starship" "neovim" "dotfiles"
}

profile "workstation-minimal" distro="alma-minimal" arch="x86_64" user="blue" {
    volume source="~/.ssh" target="/home/blue/.ssh" mode="ro"
    tools "python" "rust" "go" "neovim" "starship" "fzf" "ripgrep" "eza" "ipython" "ranger" "ssh" \
        "dotfiles"
}

profile "ws-deb" distro="debian" arch="x86_64" user="blue" {
    volume source="~/.ssh" target="/home/blue/.ssh" mode="ro"
    tools "python" "node" "rust" "go" "sdkman" "neovim" "starship" "fzf" "ripgrep" "tokei" "eza" \
        "kubectl" "ipython" "ranger" "ssh" "docker" "dotfiles"
}

profile "ws-deb-arm" distro="debian" arch="aarch64" user="blue" {
    volume source="~/.ssh" target="/home/blue/.ssh" mode="ro"
    tools "python" "node" "rust" "go" "sdkman" "neovim" "starship" "fzf" "ripgrep" "tokei" "eza" \
        "kubectl" "ipython" "ranger" "ssh" "docker" "dotfiles"
}
