    arch "x86_64" "linux_amd64"
    arch "aarch64" "linux_arm64"
    arch "darwin-aarch64" "darwin_arm64"
    install {
        run #"""
            curl -LO https://github.com/mikefarah/yq/releases/download/v$version/yq_$arch && \
            chmod +x yq_$arch && mv yq_$arch $HOME/.local/bin/yq
            """#
    }
}

