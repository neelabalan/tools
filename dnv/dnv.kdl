    arch "x86_64" "x86_64-unknown-linux-musl"
    arch "aarch64" "aarch64-unknown-linux-gnu"
    arch "darwin-aarch64" "aarch64-apple-darwin"
    install {
        run #"""
            curl -LO https://github.com/sharkdp/bat/releases/download/v$version/bat-v$version-$arch.tar.gz && \
            tar -xzf bat-v$version-$arch.tar.gz && \
            mv bat-v$version-$arch/bat $HOME/.local/bin/ && \
            rm -rf bat-v$version-$arch*
            """#
    }
}

package "fd" version="10.2.0" {
    arch "x86_64" "x86_64-unknown-linux-musl"
    arch "aarch64" "aarch64-unknown-linux-gnu"
    arch "darwin-aarch64" "aarch64-apple-darwin"
    install {
        run #"""
            curl -LO https://github.com/sharkdp/fd/releases/download/v$version/fd-v$version-$arch.tar.gz && \
            tar -xzf fd-v$version-$arch.tar.gz && \
            mv fd-v$version-$arch/fd $HOME/.local/bin/ && \
            rm -rf fd-v$version-$arch*
            """#
    }
}

package "btop" version="1.4.0" {
    arch "x86_64" "x86_64-linux-musl"
    arch "aarch64" "aarch64-linux-musl"
    arch "darwin-aarch64" "aarch64-macos"
    install {
        run #"""
            curl -LO https://github.com/aristocratos/btop/releases/download/v$version/btop-$arch.tbz && \
            tar -xjf btop-$arch.tbz && \
            mv btop/bin/btop $HOME/.local/bin/ && \
            rm -rf btop btop-$arch.tbz
            """#
    }
}

package "age" version="1.2.0" {
    arch "x86_64" "linux-amd64"
    arch "aarch64" "linux-arm64"
    arch "darwin-aarch64" "darwin-arm64"
    install {
        run #"""
            curl -LO https://github.com/FiloSottile/age/releases/download/v$version/age-v$version-$arch.tar.gz && \
            tar -xzf age-v$version-$arch.tar.gz && \
            mv age/age age/age-keygen $HOME/.local/bin/ && \
            rm -rf age age-v$version-$arch.tar.gz
            """#
    }
}

package "jq" version="1.7.1" {
    arch "x86_64" "linux-amd64"
    arch "aarch64" "linux-arm64"
    arch "darwin-aarch64" "macos-arm64"
    install {
        run #"""
            curl -LO https://github.com/jqlang/jq/releases/download/jq-$version/jq-$arch && \
            chmod +x jq-$arch && mv jq-$arch $HOME/.local/bin/jq
            """#
    }
}

