// dnv config: distros, packages and profiles for the dnv tool

// SECTION: distros  (base images, package managers, distro scripts)

// distros: base image, package manager, package-name overrides, and distro scripts
//
// base-image  image used for the Dockerfile
// arch-prefix prefix added to the host arch when looking up `arch` entries in the packages section
// install     package install command (sudo prefix is dropped in the Dockerfile)
// flags       extra flags appended to install
// update      package update command used in the Dockerfile
// packages    packages installed on every image before any tool
// scripts     shell snippets referenced by `script` install steps

distro "debian" {
    base-image "debian:bookworm"
    install "sudo apt install -y"
    update "apt update && apt upgrade -y"
    packages "curl" "tar" "unzip" "zip" "git" "make" "build-essential" "vim" "procps" "iproute2" "openssh-server"
    scripts {
        clean "sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*"
        mirror #"echo "Acquire::Retries \"3\";" > /etc/apt/apt.conf.d/80-retries"#
    }
}

distro "alma" {
    base-image "almalinux:9"
    install "sudo dnf install -y"
    flags "--skip-broken"
    update "dnf update -y"
    packages "curl" "tar" "unzip" "zip" "git" "make" "gcc" "vim" "procps" "iproute" "openssh-server"
    scripts {
        clean "dnf clean all"
        mirror #"echo "fastestmirror=True" >> /etc/dnf/dnf.conf && echo "max_parallel_downloads=10" >> /etc/dnf/dnf.conf"#
    }
}

distro "alma-minimal" {
    base-image "almalinux:9-minimal"
    install "sudo microdnf install -y"
    update "microdnf update -y"
    packages "tar" "unzip" "zip" "git" "make" "gcc" "vim" "procps" "iproute" "openssh-server"
    scripts {
        clean "dnf clean all"
        mirror "true"
    }
}

distro "cuda" {
    base-image "nvidia/cuda:11.8.0-runtime-ubi8"
    install "sudo dnf install -y"
    flags "--skip-broken"
    update "dnf update -y"
    packages "curl" "tar" "unzip" "zip" "git" "make" "gcc" "vim" "procps" "iproute" "openssh-server"
    scripts {
        clean "dnf clean all"
        mirror #"echo "fastestmirror=True" >> /etc/dnf/dnf.conf && echo "max_parallel_downloads=10" >> /etc/dnf/dnf.conf"#
    }
}

// SECTION: packages  (tools: version, dependencies, arch artifacts, install steps)

// package  tool: version, dependencies, per-arch artifact names, install steps
//
// install steps:
//   script "name"  distro script (clean)
//   run "cmd"      shell command; $version, $arch (from the arch map) and $profile are filled in
//   run-with-build-device "cmd"  run with a profile's build-device attached

package "ranger" {
    requires "python"
    install {
        run "uv tool install ranger-fm"
    }
}

package "uv" version="0.7.9" {
    env "PATH" "$HOME/.local/bin:$PATH"
    install {
        run "curl -LsSf https://astral.sh/uv/$version/install.sh | sh"
    }
}

package "python" version="3.13" {
    requires "uv"
    install {
        run "uv python install $version"
    }
}

package "nvm" version="v0.39.2" {
    install {
        run "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/$version/install.sh | bash"
    }
}

package "node" version="22" {
    requires "nvm"
    install {
        run #"""
            export NVM_DIR=$HOME/.nvm && \
            source $NVM_DIR/nvm.sh && nvm install $version
            """#
    }
}

package "rust" {
    env "PATH" "$PATH:$HOME/.cargo/bin"
    install {
        run "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | bash -s -- -y --no-modify-path"
    }
}

package "go" version="go1.23.9" {
    arch "x86_64" "linux-amd64"
    arch "aarch64" "linux-arm64"
    arch "darwin-aarch64" "darwin-arm64"
    env "PATH" "$PATH:/usr/local/go/bin"
    install {
        run #"""
            curl -LO https://go.dev/dl/$version.$arch.tar.gz && \
            sudo rm -rf /usr/local/go && sudo tar -C /usr/local -xzf $version.$arch.tar.gz && \
            rm $version.$arch.tar.gz && \
            echo 'export PATH=$PATH:/usr/local/go/bin' >> $HOME/.bashrc
            """#
    }
}

package "sdkman" {
    install {
        run "curl -s \"https://get.sdkman.io\" | bash"
    }
}

package "pnpm" version="9.15.9" {
    requires "node"
    install {
        run "curl -fsSL https://get.pnpm.io/install.sh | env PNPM_VERSION=$version sh -"
    }
}

package "ipython" {
    requires "python"
    install {
        run "uv tool install --python 3.13 ipython"
    }
}

package "neovim" version="0.11.0" {
    requires "dotfiles"
    arch "x86_64" "linux-x86_64"
    arch "aarch64" "linux-arm64"
    arch "darwin-aarch64" "macos-arm64"
    install {
        run #"""
            curl -LO https://github.com/neovim/neovim/releases/download/v$version/nvim-$arch.tar.gz && \
            mkdir -p $HOME/.local/nvim && tar -C $HOME/.local/nvim -xzf nvim-$arch.tar.gz --strip-components=1 && \
            ln -sf $HOME/.local/nvim/bin/nvim $HOME/.local/bin/nvim && \
            rm nvim-$arch.tar.gz
            """#
        run "nvim --headless \"+Lazy! sync\" +qa"
    }
}

package "starship" {
    install {
        run "curl -sS https://starship.rs/install.sh | sh -s -- -y && mkdir -p $HOME/.config"
    }
}

package "fzf" version="0.56.3" {
    arch "x86_64" "linux_amd64"
    arch "aarch64" "linux_arm64"
    arch "darwin-aarch64" "darwin_arm64"
    install {
        run #"""
            curl -LO https://github.com/junegunn/fzf/releases/download/v$version/fzf-$version-$arch.tar.gz && \
            tar -xzf fzf-$version-$arch.tar.gz && \
            mv fzf $HOME/.local/bin/ && rm fzf-$version-$arch.tar.gz
            """#
    }
}

package "ripgrep" version="14.1.1" {
    arch "x86_64" "x86_64-unknown-linux-musl"
    arch "aarch64" "aarch64-unknown-linux-gnu"
    arch "darwin-aarch64" "aarch64-apple-darwin"
    install {
        run #"""
            curl -LO https://github.com/BurntSushi/ripgrep/releases/download/$version/ripgrep-$version-$arch.tar.gz && \
            tar -xzf ripgrep-$version-$arch.tar.gz && \
            mv ripgrep-$version-$arch/rg $HOME/.local/bin/ && \
            rm -rf ripgrep-$version-$arch*
            """#
    }
}

package "tokei" version="12.1.2" {
    requires "rust"
    arch "x86_64" "x86_64"
    arch "aarch64" "aarch64"
    arch "darwin-aarch64" "aarch64"
    install {
        run "cargo install tokei --version $version --locked"
    }
}

package "eza" version="0.21.1" {
    requires "rust"
    arch "x86_64" "x86_64"
    arch "aarch64" "aarch64"
    arch "darwin-aarch64" "aarch64"
    install {
        run "cargo install eza --version $version --locked"
    }
}

